{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" },
    { "src": "admin-panel/build/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/admin", "dest": "/admin-panel/build/index.html" },
    { "src": "/admin/(.*)", "dest": "/admin-panel/build/$1" },
    { "src": "/static/(.*)", "dest": "/admin-panel/build/static/$1" }
  ]
}
