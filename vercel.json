{
  "version": 2,
  "builds": [
    { "src": "index.js", "use": "@vercel/node" },
    { "src": "admin-panel/build/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "/admin-panel/build/$1"
    },
    {
      "src": "/admin",
      "dest": "/admin-panel/build/index.html"
    },
    {
      "src": "/logo192.png",
      "dest": "/admin-panel/build/logo192.png"
    },
    {
      "src": "/logo512.png",
      "dest": "/admin-panel/build/logo512.png"
    },
    {
      "src": "/manifest.json",
      "dest": "/admin-panel/build/manifest.json"
    },
    {
      "src": "/static/(.*)",
      "dest": "/admin-panel/build/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
